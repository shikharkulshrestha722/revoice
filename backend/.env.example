# Copy this file to .env (same folder) and fill in your values.
# .env is ignored by git, so your keys stay on your computer.

# Public URL of the Colab voice server (printed by Step 6 of colab/revoice_server_v2.ipynb)
COLAB_API_URL=https://handcart-retrieval-mulch.ngrok-free.dev

# Gemini key for phrase prediction: https://aistudio.google.com/apikey
# Leave blank to use the offline word list.
GEMINI_API_KEY=

# Optional: which Gemini model to use
GEMINI_MODEL=gemini-2.5-flash

# Single switch for scanning mode: the Arduino's serial port (see Device Manager -> Ports),
# e.g. COM3. Leave blank if there is no switch: scanning then works with the spacebar.
# Close the Arduino Serial Monitor first - only one program can use the port.
SWITCH_SERIAL_PORT=
SWITCH_BAUD=9600
